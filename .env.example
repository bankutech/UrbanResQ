DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=urbanresq
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string-32+
CORS_ORIGIN=
SEED_PASSWORD=

# Optional services. Leave blank to keep them off.
# SMTP_URL=smtp://user:pass@mail.example.org:587   (use "json" for a dry run that only logs)
# MAIL_FROM=alerts@example.org
# SMS_WEBHOOK_URL=https://your-sms-gateway.example/send   (receives POST {"to","text"})
# SMS_WEBHOOK_TOKEN=
# ROUTING_URL=https://router.project-osrm.org             (any OSRM-compatible server)
# WEATHER_URL=https://api.open-meteo.com                  (default if blank)
# BACKUP_EVERY_HOURS=6
# BACKUP_KEEP=14

# Twilio SMS (alternative to SMS_WEBHOOK_URL)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550001111

# Map tiles. Default is OpenStreetMap (fine for light use). Use your own tile server for heavy or offline use.
# TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# TILE_ATTRIBUTION=© OpenStreetMap contributors

# Set to 1 when running behind one reverse proxy (nginx, a load balancer)
# TRUST_PROXY=1
